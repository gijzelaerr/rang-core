+impl TempFile {
+    /// Append double-precision complex values; their offset (a beam's
+    /// resync spectrum, research/gemclean-mem-32.md arm A).
+    pub fn append_c64(&self, v: &[Complex<f64>]) -> Result<u64, String> {
+        self.append_with(v.len(), 16, |a, b, buf| {
+            for x in &v[a..b] {
+                buf.extend_from_slice(&x.re.to_le_bytes());
+                buf.extend_from_slice(&x.im.to_le_bytes());
+            }
+        })
+    }
+
+    /// Read the values written by [`TempFile::append_c64`] at `offset` into
+    /// `out` (its length is the count), bit for bit.
+    pub fn read_c64_into(&self, offset: u64, out: &mut [Complex<f64>]) -> Result<(), String> {
+        let mut at = 0;
+        self.read_with(offset, out.len(), 16, |b| {
+            for c in b.chunks_exact(16) {
+                out[at] = Complex::new(
+                    f64::from_le_bytes(c[..8].try_into().expect("8 bytes")),
+                    f64::from_le_bytes(c[8..].try_into().expect("8 bytes")),
+                );
+                at += 1;
+            }
+        })
+    }
+}
