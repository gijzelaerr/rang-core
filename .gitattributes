# LF everywhere, whatever core.autocrlf says, so every host hashes and formats
# the same bytes (task W4-6, research/w4-6-portability.md).
* text=auto eol=lf

*.staticmask binary
*.png binary
*.npz binary
*.ico binary

# Archived and frozen bytes are never rewritten:
# research/results/p11-extract/closure.py keeps its CRLF.
research/results/** -text
history/** -text
# CARACal's strategy file, byte for byte (SHA-256 in research/e2-acceptance.md 6.3):
research/results/e2-acceptance-scripts/mk_rfi_flagging_calibrator_fields_firstpass.yaml -whitespace

# casacore tables written by python-casacore, byte for byte (tools/oracles/strarray/fixture.py):
tests/data/strarray/table/** binary
# MSv2 edge cases written by python-casacore (tools/oracles/msv2-edge/fixture.py):
tests/data/msv2-edge/t0*/** binary
